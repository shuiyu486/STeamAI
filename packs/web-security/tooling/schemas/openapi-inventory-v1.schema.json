{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:steamai:web-security:openapi-inventory-v1",
  "title": "STeamAI OpenAPI Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "adapterId", "openapiVersion", "source", "servers", "authSchemes", "endpoints", "warnings", "boundaries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "web-security-openapi-inventory" },
    "adapterId": { "const": "openapi-v3-json-inventory" },
    "openapiVersion": { "type": "string", "pattern": "^3\\.(0|1)\\.[0-9]+(?:[-+][A-Za-z0-9._-]+)?$", "maxLength": 512 },
    "source": { "$ref": "#/$defs/fileBinding" },
    "servers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheme", "host", "port", "basePath"],
        "properties": {
          "scheme": { "enum": ["http", "https"] },
          "host": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9.:_-]+$" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "basePath": { "$ref": "#/$defs/urlPath" }
        }
      }
    },
    "authSchemes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "replaySupported"],
        "properties": {
          "name": { "$ref": "#/$defs/boundedText" },
          "type": { "enum": ["apiKey", "http", "oauth2", "openIdConnect", "mutualTLS"] },
          "in": { "enum": ["header", "query", "cookie"] },
          "parameter": { "$ref": "#/$defs/boundedText" },
          "scheme": { "enum": ["bearer", "basic"] },
          "replaySupported": { "type": "boolean" }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "method", "pathTemplate", "parameters", "requestBodyRequired", "requestMediaTypes", "security"],
        "properties": {
          "key": { "$ref": "#/$defs/boundedText" },
          "operationId": { "$ref": "#/$defs/boundedText" },
          "method": { "enum": ["get", "head", "options", "post", "put", "patch", "delete", "trace"] },
          "pathTemplate": { "$ref": "#/$defs/urlPath" },
          "parameters": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "in", "required"],
              "properties": {
                "name": { "$ref": "#/$defs/boundedText" },
                "in": { "enum": ["path", "query", "header", "cookie"] },
                "required": { "type": "boolean" }
              }
            }
          },
          "requestBodyRequired": { "type": "boolean" },
          "requestMediaTypes": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/boundedText" } },
          "security": {
            "type": "array",
            "maxItems": 32,
            "items": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/boundedText" } }
          }
        }
      }
    },
    "warnings": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/boundedText" } },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnlyInput", "noNetwork", "noSecretsPersisted", "noCatalogEntryExecution", "noAuthorityOrConfirmed"],
      "properties": {
        "readOnlyInput": { "const": true },
        "noNetwork": { "const": true },
        "noSecretsPersisted": { "const": true },
        "noCatalogEntryExecution": { "const": true },
        "noAuthorityOrConfirmed": { "const": true }
      }
    }
  },
  "$defs": {
    "boundedText": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "urlPath": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/[^?#\\\\]*$" },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 }
      }
    }
  }
}
